% Sharp dependence of ||M|| on [w]_{A_p} (Theorem C in Lerner).
% Buckley, sharp bound for M on L^p(w) and its sharpness. Local copy: literature/buckley-opertor-norms-weighted-spaces.pdf
% (relative to the project folder). This is the author's preprint (Maynooth MURAL), 23 pages numbered 1-23,
% NOT the journal pagination 253-272. Preprint page = PDF page.
% Theorem 2.5 (||M|| bound, exponent best possible): preprint/PDF p. 5. Proof on pp. 5-6: weak type via
% Besicovitch, then Marcinkiewicz with the A_{p-eps} property (Lemma 2.1). Sharpness example at end of proof,
% p. 5-6: on R, w(x) = |x|^{(p-1)(1-delta)}, f(x) = |x|^{-1+delta} chi_[0,1] (our Proposition 2 is the R^d version).
% Open-access source: https://mural.maynoothuniversity.ie/2558/
@article{Buckley1993,
  author  = {Buckley, Stephen M.},
  title   = {Estimates for operator norms on weighted spaces and reverse
             {J}ensen inequalities},
  journal = {Trans. Amer. Math. Soc.},
  volume  = {340},
  number  = {1},
  year    = {1993},
  pages   = {253--272},
  doi     = {10.1090/S0002-9947-1993-1124164-0},
}

